# dashboard/.env overrides the same keys in the shell. Uncomment only as needed.
# Paperclip base URL (no /api suffix). Default: http://localhost:3100
# PAPERCLIP_API_URL=http://localhost:3100
# Blank/unset: use the only company. If there are several, enter the chosen id.
# PAPERCLIP_COMPANY_ID=
# Authenticated instances only: use a key authorized for the chosen company.
# PAPERCLIP_API_KEY=

# Herdr is optional for planning and manual handoff. Linked workers need a live, detected agent.
# Output-only overrides for older agents; this does not register agents or route tasks.
# HERDR_AGENT_MAP=Antigravity-Worker=agy-worker,Freebuff-Coder=w2:p1

# The dashboard has no login; keep it on loopback unless access is protected.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000
